PORT=4173
# LOCAL_DEV is accepted only on the loopback development server.
LOCAL_DEV=true
APP_ORIGIN=http://127.0.0.1:4173
DATABASE_PATH=.data/world.sqlite
# Required for Vercel. Use a persistent Neon/PostgreSQL connection URL.
# The local loopback server continues to use SQLite.
DATABASE_URL=
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4173/api/auth/google/callback
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
